# Optional public GA4 Measurement ID. Empty disables analytics.
# Used at build time; npm run dev never loads Analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only settings; never prefix database credentials with NEXT_PUBLIC_.
DATABASE_URL=
APP_ORIGIN=http://localhost:3000

# Turnstile: site key is public/build-time; secret is server-only/runtime.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
